# Environment variables and secrets: never commit these.
# Only the template (.env.example, with empty values) is tracked.
.env*
!.env.example
*.pem
*.key
*.p8
*.p12
*.keystore
*.jks
*firebase-adminsdk*.json
*service-account*.json
credentials*.json
secrets*.json

# Deployment
.vercel
.netlify

# Kept locally, not published (this repository is public):
# - planning documents, including security notes and unconfirmed client names
/docs/
# - hidden product pages (Work section), restored when they go public again
/preserved/

