# Copy to .env.local for local development. Never commit real secrets.

# Formspree form ID for enquiries (not secret, but kept server-side so it can change without a code release).
FORMSPREE_FORM_ID=

# Tests only: send enquiries to a local mock instead of Formspree. Leave empty in production.
FORMSPREE_ENDPOINT=

# Optional Cloudflare Turnstile spam check. Leave both empty to switch it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cal.com booking link for the 20-minute discovery call. Empty = "request mode" (no times shown).
NEXT_PUBLIC_BOOKING_URL=
